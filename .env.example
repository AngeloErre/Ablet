# Copiare in .env e compilare. Il file .env non va mai versionato né esposto dal server web.
APP_ENV=development
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ablet
DB_USER=ablet
DB_PASS=

# Chiave per cifrare le chiavi API dei provider nel database (incremento 4).
# Generare con: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_SECRET_KEY=

# Senza chiavi dei provider la piattaforma funziona in modalità dimostrativa (risposte simulate, dichiarate come tali).

# Registrazione pubblica di educatori/psicologi: 1 attiva, 0 disattiva.
ALLOW_SELF_REGISTRATION=1
